{
  "name": "@voltu/bridge-emitter",
  "version": "0.0.0",
  "description": "Durable tail-replicator: reads CitrineOS's OCPPMessages and POSTs signed envelopes to the Voltu citrine-bridge (own-station telemetry + off-box durability). Does NOT modify CitrineOS core.",
  "type": "module",
  "private": true,
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -b tsconfig.json --pretty",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "^25.3.3",
    "@types/pg": "^8.11.10",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "tsx": "^4.21.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "catalog:"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
